<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>java-functions-samples</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>samples/http-check-file</module>
        <module>samples/durable-functions</module>
        <module>samples/durable-csv-batch</module>
        <module>samples/db-initializer</module>
    </modules>
    <properties>
        <azure.identity.version>1.18.7</azure.identity.version>
        <junit.version>5.11.4</junit.version>
        <azure.package.skip>true</azure.package.skip>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>reset-functions-staging</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/azure-functions</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>azure</id>
            <activation>
                <property>
                    <name>env.AZURE_ENV_NAME</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.microsoft.azure</groupId>
                        <artifactId>azure-functions-maven-plugin</artifactId>
                        <version>1.42.0</version>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>copy-azure-monitor-agent</id>
                                <phase>package</phase>
                                <goals><goal>copy</goal></goals>
                                <configuration>
                                    <skip>${azure.package.skip}</skip>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>com.microsoft.azure</groupId>
                                            <artifactId>applicationinsights-agent</artifactId>
                                            <version>3.7.10</version>
                                            <type>jar</type>
                                            <outputDirectory>${project.build.directory}/azure-functions/${functionAppName}</outputDirectory>
                                            <destFileName>applicationinsights-agent.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>prepare-offline-azure-package</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <skip>${azure.package.skip}</skip>
                                    <executable>pwsh</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/../../scripts/Prepare-AzurePackage.ps1</argument>
                                        <argument>-ProjectDirectory</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>-AppName</argument>
                                        <argument>${functionAppName}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
